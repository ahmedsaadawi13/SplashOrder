# FILE: /.env.example
# SplashOrder Environment Configuration
# Copy this file to .env and update with your actual values

# Application
APP_NAME=SplashOrder
APP_URL=http://localhost
APP_ENV=development

# Database
DB_HOST=localhost
DB_DATABASE=splashorder
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Email (for notifications - simulated in this version)
MAIL_FROM=noreply@splashorder.com
MAIL_FROM_NAME=SplashOrder

# Upload Settings
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp

# Pagination
ITEMS_PER_PAGE=20

# Session
SESSION_LIFETIME=7200

# Security
HASH_ALGO=bcrypt
HASH_COST=10
